<Project>

  <!--
    全解决方案共享的编译设置。
    质量门禁依赖这些设置（nullable、警告即错误），修改前请评估影响。
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    当前基线没有可联网的 NuGet 源，无法确保 analyzer 包可还原；
    因此显式关闭"缺少 XML 文档注释"以外的低价值规则，避免把离线环境问题
    伪装成代码缺陷。所有 public API 仍然手工要求写文档注释（见 CLAUDE.md）。
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;CA1031;CA1303;CA1305;CA1859;CA1861;CA2007;CA1819;CA1002;CA1054;CA1056;CA1724;CA1716;CA1515;CA2237;CA1062;CA1812;CA1852;CA5394;CA5350;CA5351;CA1308;CA1858;CA1863;CA1866;CA1707;CA1063;CA1508;CA1848;CA1873;CA1869</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 项目规范文件不参与编译，避免被打包脚本误复制 -->
    <None Include="$(MSBuildThisFileDirectory)CLAUDE.md" Visible="false" />
  </ItemGroup>

</Project>
