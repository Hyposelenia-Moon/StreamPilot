<Project Sdk="Microsoft.NET.Sdk">

  <!--
    原始流录制适配层（Recording）。
    依赖规则：只允许引用 StreamPilot.Core；禁止转码，禁止调用 ffmpeg。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreamPilot.Recording</RootNamespace>
    <AssemblyName>StreamPilot.Recording</AssemblyName>
    <Description>原始流录制：FLV/TS 字节级写入、自动分片、断流重连、元数据侧车文件。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamPilot.Core\StreamPilot.Core.csproj" />
  </ItemGroup>

</Project>
