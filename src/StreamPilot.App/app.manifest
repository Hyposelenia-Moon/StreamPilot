<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="StreamPilot.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- 以普通用户权限运行：桥接服务只监听 127.0.0.1，不需要管理员权限 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!--
    DPI 感知不在此处声明：设置窗口使用了 WinForms 的"浏览文件/文件夹"对话框，
    其分析器（WFO0003）要求 DPI 由 WinForms 的 ApplicationHighDpiMode 统一配置，
    因此改由 StreamPilot.App.csproj 的 <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode> 提供，
    效果与原先的 dpiAwareness=PerMonitorV2 一致（WPF 与 WebView2 同样受益）。
  -->
</assembly>
