<Project Sdk="Microsoft.NET.Sdk">

  <!--
    表现层与组合根（App）。
    依赖规则：允许引用全部 StreamPilot 工程（组合根）；UI 层不得直接使用解析层实现类型，
    必须通过 StreamPilot.Core.Services 中的接口调用。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅用于设置窗口的"浏览文件/文件夹"对话框（OpenFileDialog / FolderBrowserDialog） -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms 分析器要求 DPI 由项目属性统一配置（app.manifest 中仍保留 PerMonitorV2） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>StreamPilot.App</RootNamespace>
    <AssemblyName>StreamPilot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 自绘图标（assets/ = 仓库根目录）：标题栏、任务栏与 exe 图标统一使用 -->
    <ApplicationIcon>..\..\assets\streampilot.ico</ApplicationIcon>
    <Description>StreamPilot 桌面应用：多平台低延迟播放、原始流录制与 mpv 外挂桥接。</Description>
    <!--
      Version 只影响包版本；AssemblyVersion 决定运行时 AppVersion.Current 的取值，
      因此必须显式指定，否则会回落到默认的 1.0.0.0。
    -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Product>StreamPilot</Product>
    <Company>StreamPilot</Company>
    <Copyright>Copyright (c) StreamPilot contributors</Copyright>
  </PropertyGroup>

  <!-- 单文件自包含发布（详见 docs/adr/0005-bridge-and-packaging.md） -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamPilot.Core\StreamPilot.Core.csproj" />
    <ProjectReference Include="..\StreamPilot.Parsers\StreamPilot.Parsers.csproj" />
    <ProjectReference Include="..\StreamPilot.Recording\StreamPilot.Recording.csproj" />
    <ProjectReference Include="..\StreamPilot.Bridge\StreamPilot.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebView2 SDK：唯一的运行时第三方依赖（见 THIRD-PARTY-NOTICES.md） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- 播放页与第三方 JS 库：作为内容随包分发，虚拟主机映射需要真实目录 -->
    <Content Include="..\..\Web\**\*">
      <Link>Web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 图标同时作为 WPF 资源，供窗口显式指定 Icon（不依赖 exe 图标回退） -->
    <Resource Include="..\..\assets\streampilot.ico">
      <Link>Assets\streampilot.ico</Link>
    </Resource>
  </ItemGroup>

</Project>
