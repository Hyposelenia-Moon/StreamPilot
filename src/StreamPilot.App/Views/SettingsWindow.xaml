<Window x:Class="StreamPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot 设置"
        Height="720" Width="900"
        MinHeight="560" MinWidth="760"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="14,12,14,8">
      <!-- ============ 常用：只放日常会改的设置项 ============ -->
      <TabItem Header="常用">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,4">
          <StackPanel>
            <Border Style="{StaticResource CardPanel}">
              <StackPanel>
                <TextBlock Text="默认平台" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <ComboBox Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding DefaultPlatformChoices}"
                          SelectedItem="{Binding SelectedDefaultPlatform, Mode=TwoWay}"
                          ToolTip="只在输入房间号、无法从链接识别平台时使用"
                          AutomationProperties.AutomationId="DefaultPlatformCombo">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="mpv 外挂播放" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="mpv 路径" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding MpvPath, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Content="探测" Command="{Binding DetectMpvCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseMpvCommand}" />
                  <Button Grid.Column="3" Content="清空" Command="{Binding ClearMpvCommand}" Margin="0" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="播放行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <CheckBox Content="解析成功后自动开始播放" IsChecked="{Binding AutoPlayOnResolve}" Margin="0,0,0,8" />
                <CheckBox Content="解析成功后自动调用 mpv 播放" IsChecked="{Binding AutoLaunchMpv}" />

                <TextBlock Text="默认音量" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Volume}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource MutedText}"
                             MinWidth="46" TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="录制" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="输出目录" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseRecordingDirectoryCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="分片大小上限（MiB）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SegmentMaxMegabytes}" Width="130" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="分片时长上限（分钟）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SegmentMaxMinutes}" Width="130" HorizontalAlignment="Left" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 高级：默认不用改 ============ -->
      <TabItem Header="高级">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,4">
          <StackPanel>
            <Border Style="{StaticResource CardPanel}">
              <StackPanel>
                <TextBlock Text="账号与 Cookie（可选）" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <TextBlock Text="哔哩哔哩 Cookie" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding BilibiliCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="抖音 Cookie" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding DouyinCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="虎牙 Cookie" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding HuyaCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="斗鱼 Cookie" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding DouyuCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="YY Cookie" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding YyCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="Bigo Cookie" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding BigoCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="52"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="网络" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="HTTP 代理" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="形如 http://127.0.0.1:10809；留空表示不使用代理，修改后需重启程序" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="请求细节" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="请求超时（秒）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RequestTimeoutSeconds}" Width="130" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="最大尝试次数（含首次）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MaxAttempts}" Width="130" HorizontalAlignment="Left" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="自定义 User-Agent" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空使用内置 Windows Chrome UA" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="录制稳定性" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="最长录制时长（分钟）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MaxDurationMinutes}" Width="110" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="断流判定（秒）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StallTimeoutSeconds}" Width="110" HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="最大重连次数" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MaxReconnectAttempts}" Width="110" HorizontalAlignment="Left"
                             ToolTip="断流后按 2/4/8/15/30 秒退避重连，达到上限即结束本次录制" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="本地桥接服务" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="首选端口" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding BridgePort}" Width="150" HorizontalAlignment="Left"
                         ToolTip="只监听 127.0.0.1；端口被占用时自动顺延" />
                <CheckBox Content="启动时自动开启" IsChecked="{Binding BridgeAutoStart}" Margin="0,10,0,0"
                          ToolTip="mpv 外挂播放依赖它" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <CheckBox Content="记录详细诊断日志" IsChecked="{Binding VerboseDiagnostics}" Margin="0,0,0,8"
                          ToolTip="排查问题时开启" />
                <TextBlock Text="日志文件个数" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding LogRetainDays}" Width="150" HorizontalAlignment="Left" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="最近事件" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="清空" Command="{Binding ClearLogLinesCommand}" Margin="0" />
                </Grid>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Height="170" Margin="0,6,0,0"
                         FontFamily="Consolas" FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="配置与清理" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
                  <Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
                  <Button Content="打开录制目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- 底部操作条 -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="保存" Click="OnSaveClick" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}" />
          <Button Content="取消" Click="OnCancelClick" MinWidth="96" Margin="0" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
