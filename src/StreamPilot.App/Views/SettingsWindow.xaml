<Window x:Class="StreamPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot 设置"
        Height="700" Width="880"
        MinHeight="520" MinWidth="720"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="10,10,10,6">
      <!-- ============ 播放 ============ -->
      <TabItem Header="播放">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <TextBlock Text="mpv 外挂播放" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

            <TextBlock Text="mpv 可执行文件路径" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding MpvPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="自动探测" Command="{Binding DetectMpvCommand}" Margin="6,0,0,0" />
              <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseMpvCommand}" />
              <Button Grid.Column="3" Content="清空" Command="{Binding ClearMpvCommand}" Margin="0" />
            </Grid>
            <TextBlock Text="留空时按顺序查找：tools\mpv\mpv.exe → tools\mpv.exe → PATH → 常见安装位置。点「自动探测」可把结果写成绝对路径。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <CheckBox Content="启动 mpv 时附加内置低延迟参数（--cache=no 等）"
                      IsChecked="{Binding UseLowLatencyMpvArguments}" Margin="0,10,0,0" />

            <TextBlock Text="附加参数（空格分隔，追加在默认参数之后）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding MpvArguments, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="示例：--vo=gpu-next --hwdec=auto-safe --profile=low-latency"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="播放行为" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <CheckBox Content="解析成功后自动开始播放" IsChecked="{Binding AutoPlayOnResolve}" Margin="0,0,0,6" />
            <CheckBox Content="解析成功后自动调用 mpv 播放（会同时打开播放页）" IsChecked="{Binding AutoLaunchMpv}" Margin="0,0,0,6" />

            <TextBlock Text="默认追帧档位（毫秒）" Style="{StaticResource MutedText}" Margin="0,8,0,4" />
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="150" GroupName="SettingsTarget" IsChecked="{Binding IsTarget150, Mode=OneWay}"
                           Command="{Binding SetTargetCommand}" CommandParameter="150" />
              <RadioButton Content="200" GroupName="SettingsTarget" IsChecked="{Binding IsTarget200, Mode=OneWay}"
                           Command="{Binding SetTargetCommand}" CommandParameter="200" />
              <RadioButton Content="250" GroupName="SettingsTarget" IsChecked="{Binding IsTarget250, Mode=OneWay}"
                           Command="{Binding SetTargetCommand}" CommandParameter="250" />
              <TextBlock Text="{Binding ExtremeTargetMs, StringFormat=当前：{0} ms}" Style="{StaticResource MutedText}" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Text="默认音量（0-100）" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding Volume}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource MutedText}" MinWidth="46" TextAlignment="Right" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 录制 ============ -->
      <TabItem Header="录制">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <TextBlock Text="输出与分片" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBlock Text="录制输出根目录" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseRecordingDirectoryCommand}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Text="留空时使用「视频」目录下的 StreamPilot 子目录；实际文件会按 {平台}\{主播}\ 分层存放。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="分片大小上限（MiB）" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
            <TextBox Text="{Binding SegmentMaxMegabytes}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="分片时长上限（分钟）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding SegmentMaxMinutes}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="分片最小字节数（MiB，避免刚开播就切出大量小文件）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding SegmentMinMegabytes}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="分片只在视频关键帧处切分，保证每个分片可独立播放。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="稳定性" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <TextBlock Text="最长录制时长（分钟）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding MaxDurationMinutes}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="断流判定（秒，超过该时长未收到数据即重连）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding StallTimeoutSeconds}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="最大重连次数" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding MaxReconnectAttempts}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="重连退避为 2/4/8/15/30 秒；达到上限后结束本次录制并写入元数据。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 预设 ============ -->
      <TabItem Header="预设">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="维护常看的直播间：保存后可在主界面「预设」下拉里直接选中并解析。"
                     Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />

          <DataGrid x:Name="PresetGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    Background="#141A22"
                    Foreground="{StaticResource TextBrush}"
                    RowBackground="#141A22"
                    AlternatingRowBackground="#171D25"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    HorizontalGridLinesBrush="{StaticResource BorderBrushSoft}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="名称（主播）" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
              <DataGridComboBoxColumn Header="平台"
                                      SelectedValueBinding="{Binding Platform, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="DisplayName"
                                      Width="120">
                <DataGridComboBoxColumn.ElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.Platforms, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Style>
                </DataGridComboBoxColumn.ElementStyle>
                <DataGridComboBoxColumn.EditingElementStyle>
                  <Style TargetType="ComboBox">
                    <Setter Property="ItemsSource" Value="{Binding DataContext.Platforms, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Style>
                </DataGridComboBoxColumn.EditingElementStyle>
              </DataGridComboBoxColumn>
              <DataGridTextColumn Header="房间号 / 直播间链接" Binding="{Binding RoomInput, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="新增预设" Command="{Binding AddPresetCommand}" />
            <Button Content="删除选中" Command="{Binding RemovePresetCommand}" />
            <TextBlock Text="{Binding Presets.Count, StringFormat=共 {0} 条}" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ 网络 ============ -->
      <TabItem Header="网络">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <TextBlock Text="请求设置" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBlock Text="HTTP 代理（留空表示不使用代理）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="示例：http://127.0.0.1:10809。修改后需重启程序生效。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="单次请求超时（秒）" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
            <TextBox Text="{Binding RequestTimeoutSeconds}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="最大尝试次数（含首次，仅对超时/连接失败/5xx/429 重试）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding MaxAttempts}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="自定义 User-Agent（留空使用内置 Windows Chrome UA）" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
            <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="B站 Cookie（可选）" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <TextBox Text="{Binding BilibiliCookie, UpdateSourceTrigger=PropertyChanged}" MinHeight="60"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="仅保存在本机 %LOCALAPPDATA%\StreamPilot\config.json，不写入日志、不随程序发布。留空时匿名解析。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 高级 ============ -->
      <TabItem Header="高级">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <TextBlock Text="本地桥接服务" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
            <TextBlock Text="首选端口（仅监听 127.0.0.1；被占用时自动顺延）" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding BridgePort}" Width="160" HorizontalAlignment="Left" />
            <CheckBox Content="启动程序时自动开启桥接服务（mpv 外挂播放依赖它）" IsChecked="{Binding BridgeAutoStart}" Margin="0,10,0,0" />
            <TextBlock Text="桥接端口不会暴露到公网：监听前缀固定为 127.0.0.1，出现通配地址会直接拒绝启动。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="日志" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <CheckBox Content="记录详细诊断日志（Trace 级）" IsChecked="{Binding VerboseDiagnostics}" Margin="0,0,0,6" />
            <TextBlock Text="保留日志文件个数" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding LogRetainDays}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Text="日志目录：%LOCALAPPDATA%\StreamPilot\logs（Cookie 与签名参数已自动脱敏）"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="配置与清理" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <TextBlock Text="配置文件：%LOCALAPPDATA%\StreamPilot\config.json" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            <TextBlock Text="预设文件：%LOCALAPPDATA%\StreamPilot\presets.json" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            <TextBlock Text="卸载或清理时删除整个 %LOCALAPPDATA%\StreamPilot 目录即可（含配置、预设、日志与 WebView2 缓存）。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
              <Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
              <Button Content="打开录制目录" Command="{Binding OpenRecordingFolderCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- 底部操作条 -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="保存" Click="OnSaveClick" MinWidth="90" IsDefault="True" />
          <Button Content="取消" Click="OnCancelClick" MinWidth="90" Margin="0" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
