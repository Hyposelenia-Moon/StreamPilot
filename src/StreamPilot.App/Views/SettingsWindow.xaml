<Window x:Class="StreamPilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot 设置"
        Height="720" Width="900"
        MinHeight="560" MinWidth="760"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
  <Grid>
    <Grid.Resources>
      <!--
        表单排版：每个设置项都是"一行标签 + 一行控件"。
        SettingLabel 用于标签行；SettingFieldBox / SettingFieldCombo 用于窄控件（统一 180px）；
        宽输入框（路径、目录、Cookie、UA）不给宽度，直接占满整行。
      -->
      <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="SettingFieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="180" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style x:Key="SettingFieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="180" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
      <Style x:Key="SettingFieldCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="SettingRow" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="CookieBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0" Margin="14,12,14,8">
      <!-- ============ 常用：日常要改的设置项 ============ -->
      <TabItem Header="常用">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,4">
          <StackPanel>
            <Border Style="{StaticResource CardPanel}">
              <StackPanel>
                <TextBlock Text="平台与播放" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <StackPanel Style="{StaticResource SettingRow}">
                  <TextBlock Text="默认平台" Style="{StaticResource SettingLabel}" />
                  <ComboBox Style="{StaticResource SettingFieldCombo}"
                            ItemsSource="{Binding DefaultPlatformChoices}"
                            SelectedItem="{Binding SelectedDefaultPlatform, Mode=TwoWay}"
                            ToolTip="只在输入房间号、无法从链接识别平台时使用"
                            AutomationProperties.AutomationId="DefaultPlatformCombo">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Style="{StaticResource SettingRow}">
                  <TextBlock Text="默认音量" Style="{StaticResource SettingLabel}" />
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="180" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Volume}" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="VolumeSlider" />
                    <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource MutedText}"
                               MinWidth="46" TextAlignment="Right" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>

                <CheckBox Content="解析成功后自动开始播放" IsChecked="{Binding AutoPlayOnResolve}"
                          Style="{StaticResource SettingFieldCheck}" />
                <CheckBox Content="解析成功后自动调用 mpv 播放" IsChecked="{Binding AutoLaunchMpv}"
                          Style="{StaticResource SettingFieldCheck}" Margin="0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="mpv 路径" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <TextBox Text="{Binding MpvPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空时按 tools\mpv 与系统路径自动探测"
                         AutomationProperties.AutomationId="MpvPathBox" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="自动探测" Command="{Binding DetectMpvCommand}" />
                  <Button Content="浏览…" Command="{Binding BrowseMpvCommand}" />
                  <Button Content="清空" Command="{Binding ClearMpvCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="录制输出目录" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <TextBox Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空时使用「视频」目录下的 StreamPilot 子目录"
                         AutomationProperties.AutomationId="RecordingDirectoryBox" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="浏览…" Command="{Binding BrowseRecordingDirectoryCommand}" />
                  <Button Content="打开目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="账号 Cookie" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="用于解析接口的登录态，填写后可获取需要登录的高画质档位。仅保存在本机配置文件中，不写入日志，不随程序分发；播放地址与中继请求均不携带该凭据。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Text="哔哩哔哩 Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding BilibiliCookie, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="BilibiliCookieBox" />

                <TextBlock Text="抖音 Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding DouyinCookie, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="DouyinCookieBox" />

                <TextBlock Text="虎牙 Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding HuyaCookie, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="HuyaCookieBox" />

                <TextBlock Text="斗鱼 Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding DouyuCookie, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="DouyuCookieBox" />

                <TextBlock Text="YY Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding YyCookie, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="YyCookieBox" />

                <TextBlock Text="Bigo Cookie" Style="{StaticResource SettingLabel}" />
                <TextBox Style="{StaticResource CookieBox}" Text="{Binding BigoCookie, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0"
                         ToolTip="仅用于本次解析请求，用于换取需要登录的高画质档位；不写入日志，不随程序分发。"
                         AutomationProperties.AutomationId="BigoCookieBox" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ 高级：默认不用改 ============ -->
      <TabItem Header="高级">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,4">
          <StackPanel>
            <Border Style="{StaticResource CardPanel}">
              <StackPanel>
                <TextBlock Text="请求" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="超时（秒）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding RequestTimeoutSeconds}" Style="{StaticResource SettingFieldBox}"
                             AutomationProperties.AutomationId="RequestTimeoutBox" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="最大尝试次数（含首次）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding MaxAttempts}" Style="{StaticResource SettingFieldBox}"
                             AutomationProperties.AutomationId="MaxAttemptsBox" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="User-Agent" Style="{StaticResource SettingLabel}" />
                <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空使用内置 Windows Chrome UA"
                         AutomationProperties.AutomationId="UserAgentBox" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="代理" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <TextBlock Text="HTTP 代理" Style="{StaticResource SettingLabel}" />
                <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="形如 http://127.0.0.1:10809；留空表示不使用代理，修改后需重启程序"
                         AutomationProperties.AutomationId="ProxyBox" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="录制分片" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="分片大小上限（GiB）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding SegmentMaxGibibytes}" Style="{StaticResource SettingFieldBox}"
                             ToolTip="达到该大小后在下一个关键帧处切分；1 GiB = 1024 MiB，可填小数，没有上限"
                             AutomationProperties.AutomationId="SegmentMaxMegabytesBox" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="分片时长上限（小时）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding SegmentMaxHours}" Style="{StaticResource SettingFieldBox}"
                             ToolTip="达到该时长后同样在下一个关键帧处切分；可填小数，没有上限"
                             AutomationProperties.AutomationId="SegmentMaxMinutesBox" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="分片最小字节数（MiB）" Style="{StaticResource SettingLabel}" />
                <TextBox Text="{Binding SegmentMinMegabytes}" Style="{StaticResource SettingFieldBox}"
                         ToolTip="低于该大小不切分，避免切出大量小文件"
                         AutomationProperties.AutomationId="SegmentMinMegabytesBox" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="录制稳定性" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="最长录制时长（小时）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding MaxDurationHours}" Style="{StaticResource SettingFieldBox}"
                             ToolTip="单次录制达到该时长即自动结束；可填小数，没有上限"
                             AutomationProperties.AutomationId="MaxDurationMinutesBox" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="断流判定（秒）" Style="{StaticResource SettingLabel}" />
                    <TextBox Text="{Binding StallTimeoutSeconds}" Style="{StaticResource SettingFieldBox}"
                             AutomationProperties.AutomationId="StallTimeoutBox" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="最大重连次数" Style="{StaticResource SettingLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding MaxReconnectAttempts}" Style="{StaticResource SettingFieldBox}"
                         ToolTip="断流后按 2/4/8/15/30 秒退避重连，达到上限即结束本次录制"
                         AutomationProperties.AutomationId="MaxReconnectAttemptsBox" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="本地桥接服务" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <TextBlock Text="首选端口" Style="{StaticResource SettingLabel}" />
                <TextBox Text="{Binding BridgePort}" Style="{StaticResource SettingFieldBox}"
                         ToolTip="只监听 127.0.0.1；端口被占用时自动顺延"
                         AutomationProperties.AutomationId="BridgePortBox" />

                <CheckBox Content="启动时自动开启" IsChecked="{Binding BridgeAutoStart}" Margin="0,12,0,0"
                          ToolTip="mpv 外挂播放依赖它" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <CheckBox Content="记录详细诊断日志" IsChecked="{Binding VerboseDiagnostics}" Margin="0,0,0,8"
                          ToolTip="排查问题时开启" />

                <TextBlock Text="日志文件个数" Style="{StaticResource SettingLabel}" />
                <TextBox Text="{Binding LogRetainDays}" Style="{StaticResource SettingFieldBox}"
                         AutomationProperties.AutomationId="LogRetainDaysBox" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="最近事件" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="清空" Command="{Binding ClearLogLinesCommand}" Margin="0" />
                </Grid>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Height="170" Margin="0,6,0,0"
                         FontFamily="Consolas" FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="配置与清理" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
                  <Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" />
                  <Button Content="打开录制目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- 底部操作条：保存/取消固定在右下角，主按钮用主题蓝 -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="保存" Click="OnSaveClick" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}"
                  AutomationProperties.AutomationId="SettingsSaveButton" />
          <Button Content="取消" Click="OnCancelClick" MinWidth="96" Margin="0" IsCancel="True"
                  AutomationProperties.AutomationId="SettingsCancelButton" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
