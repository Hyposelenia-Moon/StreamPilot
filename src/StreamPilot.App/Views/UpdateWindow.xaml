<Window x:Class="StreamPilot.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot 更新"
        Height="600" Width="700"
        MinHeight="480" MinWidth="560"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 版本对比：当前 → 新版本 -->
    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="当前版本" Style="{StaticResource MutedText}" FontSize="12" />
          <TextBlock x:Name="CurrentVersionText" Text="0.0.0" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{StaticResource MutedTextBrush}"
                   VerticalAlignment="Bottom" Margin="16,0,16,3" />
        <StackPanel Grid.Column="2">
          <TextBlock Text="新版本" Style="{StaticResource MutedText}" FontSize="12" />
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="NewVersionText" Text="0.0.0" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentStrongBrush}" Margin="0,2,0,0" />
            <TextBlock x:Name="PublishedText" Style="{StaticResource MutedText}" FontSize="12"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="更新内容" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />

    <!-- 更新说明：只读文本框（可选中复制），Markdown 原文照示，不做渲染 -->
    <TextBox Grid.Row="2"
             x:Name="NotesBox"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             VerticalContentAlignment="Top"
             Background="{StaticResource CardBackgroundBrush}"
             Padding="10,8" />

    <!-- 进度与状态 -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
      <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="1"
                   Visibility="Collapsed" Margin="0,8,0,0" />
    </StackPanel>

    <!-- 操作按钮 -->
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" x:Name="OpenReleaseButton" Content="在浏览器打开"
              Click="OnOpenReleaseClick" Margin="0,0,8,0"
              ToolTip="用浏览器打开这个版本的发布页，可手动下载" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="CloseButton" Content="关闭" Click="OnCloseClick" Margin="0,0,8,0" />
        <Button x:Name="PrimaryButton" Content="下载并安装" Click="OnPrimaryClick"
                Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="120" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
