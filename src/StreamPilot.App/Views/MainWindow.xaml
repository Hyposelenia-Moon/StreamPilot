<Window x:Class="StreamPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot"
        Height="900" Width="1480"
        MinHeight="600" MinWidth="1320"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ControlColumn" Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：控制面板（进入全屏时整体隐藏，把窗口让给播放区域） -->
    <Border Grid.Column="0"
            x:Name="ControlPanel"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid x:Name="ControlPanelContent">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

        <!-- 顶栏：收起面板 + 标题 + 设置入口；平台选择已取消（解析时按链接域名自动识别） -->
        <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="StreamPilot 控制台" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="⚙ 设置" Command="{Binding OpenSettingsCommand}"
                    Padding="12,7" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenSettingsButton" />
            <Button Grid.Column="2" x:Name="CollapsePanelButton" Content="◀"
                    Padding="8,7" Margin="0" Click="OnToggleControlPanel"
                    ToolTip="收起控制面板（把宽度让给画面）" />
          </Grid>
        </Border>

        <!-- 当前直播常驻条：主播 / 开播状态 / 标题，不再占用卡片入口 -->
        <Border Grid.Row="1" Padding="14,10" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="6" Padding="8,2" Background="{StaticResource AccentSoftBrush}"
                      VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding LiveStatus}" Foreground="{StaticResource AccentStrongBrush}"
                           FontWeight="SemiBold" FontSize="12" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding RoomAnchor}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding RoomAnchor}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RoomCategory}" Style="{StaticResource MutedText}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding RoomCategory}" VerticalAlignment="Center"
                         MaxWidth="96" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding RoomTitle}" Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RoomTitle}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!--
          单页控制面板：预设 → 直播源 → 录制，三块上下平铺。
          v0.2.2 一度拆成「预设 / 直播源 / 录制」三个 Tab，实测是负优化：
          预设与直播源各自只占半屏，却要在两者之间来回切换，Tab 标题栏本身还白占一行；
          三块在 900 高的窗口里本来就能一屏放下，因此改回平铺（外层保留滚动兜底）。
        -->
        <ScrollViewer Grid.Row="2" x:Name="ControlScroll" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
          <StackPanel>
            <!-- ===== 预设 ===== -->
            <Border Style="{StaticResource CardPanel}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="预设" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" />
                  <Button Grid.Column="1" Content="新增预设" Command="{Binding SavePresetCommand}"
                          Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                          AutomationProperties.AutomationId="AddPresetButton"
                          ToolTip="填写主播名称、直播链接与平台，解析成功后保存为预设（粘贴链接时自动识别平台）" />
                  <Button Grid.Column="2" Command="{Binding RefreshPresetStatusCommand}" Margin="0"
                          ToolTip="重新检测预设是否开播">
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Text" Value="刷新状态" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingPresets}" Value="True">
                              <Setter Property="Text" Value="检查中…" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding PresetSummary}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,6,0,8" />

                <StackPanel Grid.Row="2">
                  <ListBox ItemsSource="{Binding PresetItems}"
                           SelectedItem="{Binding SelectedPresetItem, Mode=TwoWay}"
                           MaxHeight="240"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="RowRoot" Background="Transparent" CornerRadius="6" Padding="2">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- 平台徽标：自绘圆角小方块 + 平台简称，不依赖任何图片资源 -->
                          <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                  Background="{Binding BadgeBrush}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding BadgeText}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>

                          <Button Grid.Column="1"
                                  Command="{Binding ApplyCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip="{Binding ToolTipText}"
                                  HorizontalContentAlignment="Left"
                                  Padding="0"
                                  Margin="0"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                          </Button>

                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding AutoRecord}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"
                                      ToolTip="开播自动录制（检测到开播即开始录制，下播自动停止）"
                                      AutomationProperties.AutomationId="AutoRecordCheckBox" />
                            <Button Content="编辑"
                                    Command="{Binding DataContext.EditPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="EditPresetButton"
                                    ToolTip="修改主播名称、直播链接或平台"
                                    Padding="10,5"
                                    Margin="6,0,0,0" />
                            <Button Content="删除"
                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="删除这个预设"
                                    Padding="10,5"
                                    Margin="6,0,0,0" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== 直播源 ===== -->
            <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="直播源" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

                <!-- 平台不可选：解析时按输入链接的域名自动识别，识别不出时用设置里的默认平台 -->
                <TextBlock Text="{Binding PlatformStatusText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                <TextBox Text="{Binding RoomInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                         ToolTip="粘贴直播间链接；直接输入纯数字房间号会自动转换成对应平台的直播间链接（按域名/当前平台识别）" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="解析房间" Command="{Binding ResolveCommand}" Style="{StaticResource PrimaryButton}"
                          ToolTip="粘贴直播间链接；直接输入纯数字房间号会自动转换成对应平台的直播间链接（按域名/当前平台识别）" />
                  <Button Content="mpv 播放" Command="{Binding MpvCommand}" Margin="0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="mpv 线路" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <ComboBox ItemsSource="{Binding MpvLineOptions}"
                            SelectedIndex="{Binding SelectedMpvLineIndex}"
                            MinWidth="140"
                            ToolTip="mpv 外挂播放时使用哪条线路；默认「自动」会按编码/封装选最优候选" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ===== 录制 ===== -->
            <TextBlock Text="直播回放录制" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />

            <TextBlock Text="原样保存直播流，不转码、自动分段、断流重连；最高画质请在设置里填写对应平台的 Cookie。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Button Content="开始录制" Command="{Binding StartRecordingCommand}" Style="{StaticResource PrimaryButton}"
                      ToolTip="原样保存直播流，不转码；超出分片上限或主播断流时自动开新分片" />
              <Button Content="停止录制" Command="{Binding StopRecordingCommand}" />
              <Button Content="打开目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="{Binding RecordingSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecordingDirectory, StringFormat=输出目录：{0}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </Grid>

        <!--
          折叠态窄条：收起后面板只保留 36px 宽的一条，恢复入口留在这里。
          不能把恢复按钮浮在播放区上——WebView2 是原生 HWND（HwndHost），
          会盖住同一 Grid 里后声明的 WPF 元素，按钮既看不见也点不到。
        -->
        <Border x:Name="CollapsedRail"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackgroundBrush}">
          <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="▶"
                    Padding="8,6"
                    Margin="0"
                    Click="OnRestoreControlPanel"
                    AutomationProperties.AutomationId="ExpandPanelButton"
                    ToolTip="展开控制面板" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 右侧：WebView2 播放宿主（在代码后置中挂载，避免 XAML 直接依赖宿主类型） -->
    <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
      <Grid x:Name="PlayerHostContainer" />
    </Border>
  </Grid>
</Window>
