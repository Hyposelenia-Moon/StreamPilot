<Window x:Class="StreamPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot"
        Height="820" Width="1460"
        MinHeight="560" MinWidth="1320"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：控制面板 -->
    <Border Grid.Column="0"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 预设栏：选中即填入平台与房间号并自动解析；右侧齿轮打开独立设置窗口 -->
        <Border Grid.Row="0" Padding="10,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="预设" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
            <Grid Grid.Column="1">
              <ComboBox x:Name="PresetCombo"
                        ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                        ToolTip="选择预设后自动填入平台与房间号并开始解析">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="（在设置中添加）"
                         IsHitTestVisible="False"
                         Margin="10,0,0,0"
                         HorizontalAlignment="Left">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button Grid.Column="2" Content="解析预设" Command="{Binding ApplyPresetCommand}"
                    CommandParameter="{Binding SelectedPreset}" Margin="6,0,0,0" />
            <Button Grid.Column="3" Content="⚙" Command="{Binding OpenSettingsCommand}"
                    ToolTip="打开设置窗口" MinWidth="34" Padding="6,4" Margin="0"
                    AutomationProperties.AutomationId="OpenSettingsButton" />
          </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="ControlTabs" Background="Transparent" BorderThickness="0">
        <!-- ================= 直播 ================= -->
        <TabItem Header="直播">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
              <TextBlock Text="平台" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
              <ComboBox ItemsSource="{Binding Platforms}"
                        SelectedItem="{Binding SelectedPlatformOption, Mode=TwoWay}"
                        AutomationProperties.AutomationId="PlatformCombo">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="房间号 / 直播间链接" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
              <TextBox Text="{Binding RoomInput, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{Binding RoomUrlHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="解析房间" Command="{Binding ResolveCommand}" />
                <Button Content="开始播放" Command="{Binding PlayCommand}" />
                <Button Content="mpv 播放" Command="{Binding MpvCommand}" />
              </StackPanel>

              <TextBlock Text="极限追帧档位" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
              <StackPanel Orientation="Horizontal">
                <RadioButton Content="150 ms" GroupName="ExtremeTarget" IsChecked="{Binding IsTarget150, Mode=OneWay}"
                             Command="{Binding SetTargetCommand}" CommandParameter="150" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" />
                <RadioButton Content="200 ms" GroupName="ExtremeTarget" IsChecked="{Binding IsTarget200, Mode=OneWay}"
                             Command="{Binding SetTargetCommand}" CommandParameter="200" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0" />
                <RadioButton Content="250 ms" GroupName="ExtremeTarget" IsChecked="{Binding IsTarget250, Mode=OneWay}"
                             Command="{Binding SetTargetCommand}" CommandParameter="250" Foreground="{StaticResource TextBrush}" />
              </StackPanel>
              <TextBlock Text="数值越小延迟越低，网络抖动时更容易卡顿。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="追帧" Command="{Binding ChaseCommand}" />
                <Button Content="停止播放" Command="{Binding StopCommand}" />
              </StackPanel>

              <Border Background="#141A22" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                      CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding RoomAnchor, StringFormat=主播：{0}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RoomTitle, StringFormat=标题：{0}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RoomCategory, StringFormat=分区：{0}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StatusMessage, StringFormat=状态：{0}}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding PlayerTelemetry}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="候选线路" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
              <ListBox ItemsSource="{Binding CandidateSummaries}" Height="120" Background="#141A22"
                       Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ================= 录制 ================= -->
        <TabItem Header="录制">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
              <TextBlock Text="原始流录制（不转码、不重新编码）" FontWeight="SemiBold" />
              <TextBlock Text="按大小或时长自动分片；断流后自动重连；同时写入主播名、房间号、标题、开播时间与录制时长。"
                         Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="开始录制" Command="{Binding StartRecordingCommand}" />
                <Button Content="停止录制" Command="{Binding StopRecordingCommand}" />
                <Button Content="打开输出目录" Command="{Binding OpenRecordingFolderCommand}" />
              </StackPanel>

              <Border Background="#141A22" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                      CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding RecordingSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RecordingDirectory, StringFormat=输出目录：{0}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ================= 日志 ================= -->
        <TabItem Header="日志">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="界面事件（完整日志见「设置 → 高级」中的日志目录）"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Background="#141A22"
                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                     FontFamily="Consolas" FontSize="12" />
            <Button Grid.Row="2" Content="打开日志目录" Command="{Binding OpenLogFolderCommand}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" />
          </Grid>
        </TabItem>
      </TabControl>
      </Grid>
    </Border>

    <!-- 右侧：WebView2 播放宿主（在代码后置中挂载，避免 XAML 直接依赖宿主类型） -->
    <Border Grid.Column="1" Background="Black">
      <Grid x:Name="PlayerHostContainer" />
    </Border>
  </Grid>
</Window>
