<Window x:Class="StreamPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot"
        Height="840" Width="1480"
        MinHeight="600" MinWidth="1320"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ControlColumn" Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：控制面板（进入全屏时整体隐藏，把窗口让给播放区域） -->
    <Border Grid.Column="0"
            x:Name="ControlPanel"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：只保留设置入口；平台选择已取消（解析时按链接域名自动识别） -->
        <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="StreamPilot 控制台" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="⚙ 设置" Command="{Binding OpenSettingsCommand}"
                    ToolTip="默认平台、Cookie、录制、日志"
                    Padding="12,7" Margin="0" AutomationProperties.AutomationId="OpenSettingsButton" />
          </Grid>
        </Border>

        <!-- 单页控制面板：预设 → 直播源 → 播放控制 → 状态 → 录制 -->
        <ScrollViewer Grid.Row="1" x:Name="ControlTabs" VerticalScrollBarVisibility="Auto" Padding="14,12,14,18">
          <StackPanel>
            <!-- ===== 预设（独立成区，位于「直播源」上方） ===== -->
            <Border Style="{StaticResource CardPanel}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="预设" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" />
                  <Button Grid.Column="1" Content="新增预设" Command="{Binding SavePresetCommand}"
                          Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                          AutomationProperties.AutomationId="AddPresetButton"
                          ToolTip="把「直播源」里的房间号或链接存成预设" />
                  <Button Grid.Column="2" Command="{Binding RefreshPresetStatusCommand}" Margin="0"
                          ToolTip="重新检测预设是否开播">
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Text" Value="刷新状态" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingPresets}" Value="True">
                              <Setter Property="Text" Value="检查中…" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding PresetSummary}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,6,0,8" />

                <StackPanel Grid.Row="2">
                  <TextBlock Text="填好房间号后点「新增预设」。" TextWrapping="Wrap" Margin="0,0,0,4">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasPresets}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <ListBox ItemsSource="{Binding PresetItems}"
                           SelectedItem="{Binding SelectedPresetItem, Mode=TwoWay}"
                           MaxHeight="240"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="RowRoot" Background="Transparent" CornerRadius="6" Padding="2">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- 平台徽标：自绘圆角小方块 + 平台简称，不依赖任何图片资源 -->
                          <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                  Background="{Binding BadgeBrush}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding BadgeText}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>

                          <Button Grid.Column="1"
                                  Command="{Binding ApplyCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip="{Binding ToolTipText}"
                                  HorizontalContentAlignment="Left"
                                  Padding="0"
                                  Margin="0"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                          </Button>

                          <Button Grid.Column="2"
                                  Content="删除"
                                  Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="删除这个预设"
                                  Padding="10,5"
                                  Margin="6,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== 直播源 ===== -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="直播源" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <!-- 平台不可选：解析时按输入链接的域名自动识别，识别不出时用设置里的默认平台 -->
                <TextBlock Text="{Binding PlatformStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PlatformHintText}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="房间号 / 直播间链接" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding RoomInput, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding RoomUrlHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="解析房间" Command="{Binding ResolveCommand}" Style="{StaticResource PrimaryButton}" />
                  <Button Content="mpv 播放" Command="{Binding MpvCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ===== 播放控制（开始播放、追帧、档位、暂停都在右侧播放页底部） ===== -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="播放控制" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Button Command="{Binding StopCommand}" Padding="16,7" HorizontalAlignment="Left"
                        ToolTip="暂停不结束会话，「继续播放」从当前位置恢复；开始播放 / 追帧 / 档位在播放页底部">
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="暂停播放" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlaybackPaused}" Value="True">
                            <Setter Property="Text" Value="继续播放" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
              </StackPanel>
            </Border>

            <!-- ===== 状态 ===== -->
            <TextBlock Text="当前直播" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
            <Border Style="{StaticResource CardPanel}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="直播状态：" />
                  <TextBlock Text="{Binding LiveStatus}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding RoomAnchor, StringFormat=主播：{0}}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding RoomTitle, StringFormat=标题：{0}}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding RoomCategory, StringFormat=分区：{0}}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding StatusMessage, StringFormat=状态：{0}}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding PlayerTelemetry}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding BridgeStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <!-- 线路只报数量，不暴露任何 CDN 主机名与完整地址 -->
                <TextBlock Text="{Binding CandidateLineSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <!-- ===== 录制 ===== -->
            <TextBlock Text="直播回放录制" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
            <TextBlock Text="原样保存直播流：不转码；超出分片上限或主播断流时自动开新分片。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="开始录制" Command="{Binding StartRecordingCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="停止录制" Command="{Binding StopRecordingCommand}" />
              <Button Content="打开目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="{Binding RecordingSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecordingDirectory, StringFormat=输出：{0}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 右侧：WebView2 播放宿主（在代码后置中挂载，避免 XAML 直接依赖宿主类型） -->
    <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
      <Grid x:Name="PlayerHostContainer" />
    </Border>
  </Grid>
</Window>
