<Window x:Class="StreamPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamPilot"
        Height="840" Width="1480"
        MinHeight="600" MinWidth="1320"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="pack://application:,,,/Assets/streampilot.ico"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ControlColumn" Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左侧：控制面板（进入全屏时整体隐藏，把窗口让给播放区域） -->
    <Border Grid.Column="0"
            x:Name="ControlPanel"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：只保留设置入口；平台选择已取消（解析时按链接域名自动识别） -->
        <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="StreamPilot 控制台" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="⚙ 设置" Command="{Binding OpenSettingsCommand}"
                    Padding="12,7" Margin="0" AutomationProperties.AutomationId="OpenSettingsButton" />
          </Grid>
        </Border>

        <!-- 单页控制面板：预设 → 直播源 → 录制（播放状态与遥测只在画面下方的状态行显示，左栏不再重复） -->
        <ScrollViewer Grid.Row="1" x:Name="ControlTabs" VerticalScrollBarVisibility="Auto" Padding="14,12,14,18">
          <StackPanel>
            <!-- ===== 预设 ===== -->
            <Border Style="{StaticResource CardPanel}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="预设" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" />
                  <Button Grid.Column="1" Content="新增预设" Command="{Binding SavePresetCommand}"
                          Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                          AutomationProperties.AutomationId="AddPresetButton"
                          ToolTip="把「直播源」里的房间号或链接存成预设" />
                  <Button Grid.Column="2" Command="{Binding RefreshPresetStatusCommand}" Margin="0"
                          ToolTip="重新检测预设是否开播">
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Text" Value="刷新状态" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingPresets}" Value="True">
                              <Setter Property="Text" Value="检查中…" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding PresetSummary}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,6,0,8" />

                <StackPanel Grid.Row="2">
                  <ListBox ItemsSource="{Binding PresetItems}"
                           SelectedItem="{Binding SelectedPresetItem, Mode=TwoWay}"
                           MaxHeight="240"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="RowRoot" Background="Transparent" CornerRadius="6" Padding="2">
                                <ContentPresenter />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="RowRoot" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- 平台徽标：自绘圆角小方块 + 平台简称，不依赖任何图片资源 -->
                          <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                  Background="{Binding BadgeBrush}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding BadgeText}" Foreground="#FFFFFF" FontWeight="SemiBold"
                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>

                          <Button Grid.Column="1"
                                  Command="{Binding ApplyCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip="{Binding ToolTipText}"
                                  HorizontalContentAlignment="Left"
                                  Padding="0"
                                  Margin="0"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                          </Button>

                          <Button Grid.Column="2"
                                  Content="删除"
                                  Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="删除这个预设"
                                  Padding="10,5"
                                  Margin="6,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== 直播源 ===== -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="直播源" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <!-- 平台不可选：解析时按输入链接的域名自动识别，识别不出时用设置里的默认平台 -->
                <TextBlock Text="{Binding PlatformStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock Text="房间号 / 直播间链接" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                <TextBox Text="{Binding RoomInput, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="解析房间" Command="{Binding ResolveCommand}" Style="{StaticResource PrimaryButton}"
                          ToolTip="支持房间号或直播间链接；粘贴链接时按域名自动识别平台" />
                  <Button Content="mpv 播放" Command="{Binding MpvCommand}" Margin="0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ===== 当前直播 =====
                 只显示主播 / 标题 / 分区三行：宿主状态文字在画面下方状态行显示，
                 候选线路摘要与桥接状态不再进卡片（避免与状态行重复）。 -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="当前直播" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="主播：" Style="{StaticResource MutedText}" Margin="0,0,0,2" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RoomAnchor}" Style="{StaticResource ValueLine}"
                             ToolTip="{Binding RoomAnchor}" Margin="0,0,0,2" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="标题：" Style="{StaticResource MutedText}" Margin="0,0,0,2" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RoomTitle}" Style="{StaticResource ValueLine}"
                             ToolTip="{Binding RoomTitle}" Margin="0,0,0,2" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="分区：" Style="{StaticResource MutedText}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoomCategory}" Style="{StaticResource ValueLine}"
                             ToolTip="{Binding RoomCategory}" />
                </Grid>

                <TextBlock Text="当前线路卡顿会自动切换到下一条候选" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <!-- ===== 录制 ===== -->
            <TextBlock Text="直播回放录制" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />

            <TextBlock Text="想拿最高画质（B站 4K/HDR、虎牙蓝光20M 等）需要在设置里填写对应平台的 Cookie。（设置 → 高级 → 账号）"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Button Content="开始录制" Command="{Binding StartRecordingCommand}" Style="{StaticResource PrimaryButton}"
                      ToolTip="原样保存直播流，不转码；超出分片上限或主播断流时自动开新分片" />
              <Button Content="停止录制" Command="{Binding StopRecordingCommand}" />
              <Button Content="打开目录" Command="{Binding OpenRecordingFolderCommand}" Margin="0" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="{Binding RecordingSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecordingDirectory, StringFormat=输出目录：{0}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 右侧：WebView2 播放宿主（在代码后置中挂载，避免 XAML 直接依赖宿主类型） -->
    <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
      <Grid x:Name="PlayerHostContainer" />
    </Border>
  </Grid>
</Window>
